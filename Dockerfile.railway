# Imagen "todo en uno" para Railway: API + web en un solo servicio (Railway pone HTTPS y el dominio).
# En la VM de producción se sigue usando docker-compose.yml (nginx + api + db).
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SERVIR_WEB=1 WEB_DIR=/srv/web FOTOS_DIR=/data/fotos
WORKDIR /srv
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && mkdir -p /data/fotos
COPY api/app ./app
COPY web ./web
# Railway monta el volumen de fotos como root, por eso este contenedor corre como root (RAILWAY_RUN_UID=0).
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips '*'"]
