# Copiar a .env y completar. No subir .env al repositorio.
DB_ROOT_PASSWORD=cambiar-por-una-clave-larga
DB_PASSWORD=cambiar-por-otra-clave-larga
SESION_HORAS=12
# Carpeta de la VM donde quedan las fotos (puede ser un montaje NFS del Synology)
FOTOS_HOST_DIR=./datos/fotos
# 127.0.0.1 = solo accesible desde la VM (túnel). Usar la IP de la VM si se publica por el FortiGate.
WEB_BIND=127.0.0.1
# Token del túnel de Cloudflare (Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
